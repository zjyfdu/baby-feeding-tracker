# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/baby_tracker

# CORS: "*" allows all origins, or a URL like "http://localhost:5173"
CORS_ORIGIN=*

# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
